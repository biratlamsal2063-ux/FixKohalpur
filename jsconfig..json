{
    "compilerOptions": {
        "jsx": "react-native",
        "baseUrl": ".",
        "paths": {
            "*": [
                "src/*"
            ]
        },
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "ES6",
        "lib": [
            "ES6"
        ]
    },
    "exclude": [
        "node_modules",
        "babel.config.js",
        "metro.config.js"
    ]
}